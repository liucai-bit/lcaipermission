<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/lcai_tips_dialog_richtext_l1"
        android:orientation="vertical"
        android:background="@drawable/lcai_tips_dialog_bg"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="30dp"
        android:paddingVertical="20dp"
        android:paddingHorizontal="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/lcai_tips_dialog_richtext_t1"
            android:visibility="gone"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <com.liucai.jsbridge.web.LcaiBridgeWebview
            android:id="@+id/lcai_tips_dialog_richtext_w1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:background="@color/transparent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:scrollbars="none"
            android:focusable="false"
            android:focusableInTouchMode="true"
            app:layout_constraintHeight_max="340dp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/lcai_tips_dialog_richtext_m1"
        android:layout_marginTop="20dp"
        android:src="@mipmap/lcai_cancel"
        android:layout_width="25dp"
        android:layout_height="25dp"/>


</LinearLayout>