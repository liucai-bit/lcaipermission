<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Lcpermission" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="LcaiTransparentTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- 设置窗口背景为透明 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 设置窗口为半透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- 不设置窗口动画 -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="LcaiDialogTheme" parent="@android:style/Theme.Dialog">
        <!-- 1. 背景变暗 (0.0 到 1.0，0.5 表示半透明黑色遮罩) -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.1</item>
        <!-- 2. 窗口属性 -->
        <!-- 无标题栏 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 悬浮窗口 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 窗口背景透明 (为了让自定义的圆角背景生效，必须设为透明) -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 点击外部不消失 (代码中控制，这里默认设为false允许点击外部) -->
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>