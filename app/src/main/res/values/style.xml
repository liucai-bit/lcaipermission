<resources xmlns:tools="http://schemas.android.com/tools">
    <declare-styleable name="BusinessNodeStatusBar">
        <!--标题大小-->
        <attr name="titleSize" format="integer"/>
        <!--标题颜色-->
        <attr name="titleColor" format="color"/>
        <attr name="titleStyle" format="enum">
            <enum name="normal" value="0" />
            <enum name="bold" value="1" />
            <enum name="italic" value="2" />
        </attr>
        <!--每行显示多少个-->
        <attr name="columns" format="integer"/>
        <!--标题-->
        <attr name="title" format="string"/>
        <!--文字显示规则-->
        <attr name="ellipsize" format="enum">
            <enum name="DEFAULT" value="0"/>
            <enum name="SINGLELINE" value="1"/>
            <enum name="END" value="2"/>
            <enum name="MARQUEE " value="3"/>
        </attr>
        <!--图标宽度-->
        <attr name="iconWidth" format="integer"/>
        <!--图标高度-->
        <attr name="iconHeight" format="integer"/>
        <!--图标上下间距-->
        <attr name="itemSpace" format="integer"/>
        <!--item文字大小-->
        <attr name="itemTextSize" format="integer"/>
        <!--item文字颜色-->
        <attr name="itemTextColor" format="color"/>
        <!--背景-->
        <attr name="barBackground" format="reference|color"/>
        <!--角标文字大小-->
        <attr name="badgeSize" format="integer"/>
        <!--角标文字颜色-->
        <attr name="badgeColor" format="color"/>
        <!--角标背景-->
        <attr name="badgeBackground" format="reference"/>
        <!--角标最大显示数量-->
        <attr name="maxNumber" format="integer"/>
        <!--是否支持最大+显示-->
        <attr name="isMax" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="ViewFlipperCarousel">
        <attr name="indicatePoint" format="enum">
            <enum name="bottom_center" value="0"/>
            <enum name="bottom_left" value="1"/>
            <enum name="bottom_right" value="2"/>
            <enum name="top_center" value="3"/>
            <enum name="top_left" value="4"/>
            <enum name="top_right" value="5"/>
        </attr>
        <attr name="direction" format="enum">
            <enum name="vertical" value="0"/>
            <enum name="horizontal" value="1"/>
        </attr>
        <attr name="speed" format="integer"/>
        <attr name="autoPlay" format="boolean"/>
        <attr name="isSupportGesture" format="boolean"/>
        <attr name="showReferencePoint" format="boolean"/>
        <attr name="maxPointSize" format="integer"/>
        <attr name="pointStyle" format="enum">
            <enum name="cricle" value="0"/>
            <enum name="line" value="1"/>
        </attr>
        <attr name="flipper_mode" format="enum">
            <enum name="text" value="0"/>
            <enum name="image" value="1"/>
            <enum name="view" value="2"/>
        </attr>
        <attr name="centerMode" format="enum">
            <enum name="center" value="0"/>
            <enum name="left" value="1"/>
            <enum name="right" value="2"/>
        </attr>
        <attr name="fontSize" format="integer"/>
        <attr name="fontColor" format="reference"/>
        <attr name="checkColor" format="color"/>
        <attr name="uncheckColor" format="reference"/>
    </declare-styleable>

    <declare-styleable name="BadgeView">
        <!--背景配置-->
        <attr name="bBackground" format="reference"/>
        <!--字体大小配置-->
        <attr name="bTextSize" format="integer"/>
        <!--文字颜色配置-->
        <attr name="bTextColor" format="color"/>
        <!--最大显示数量,超出最大显示数量将显示99+-->
        <attr name="bMaxNumber" format="integer"/>
        <!--是否支持最大显示-->
        <attr name="bIsMax" format="boolean"/>
        <!--角标数字-->
        <attr name="bBadge" format="integer"/>
    </declare-styleable>

    <declare-styleable name="HorizonalBreadBar">
        <attr name="textSize" format="integer"/>
        <attr name="textColor" format="color"/>
        <attr name="breadBackground" format="reference"/>
    </declare-styleable>

    <declare-styleable name="LcaiRecyclerView">
        <!--是否开启下拉刷新-->
        <attr name="isPullRefresh" format="boolean"/>
        <!--是否开启上拉加载-->
        <attr name="isLoadMore" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="HorizonalLabelBar">
        <!--是否允许换行-->
        <attr name="labelWrap" format="enum">
            <enum name="NOWRAP" value="0"/>
            <enum name="WRAP" value="1"/>
            <enum name="WRAP_REVERSE" value="2"/>
        </attr>

        <attr name="labelDirection" format="enum">
            <enum name="ROW" value="0"/>
            <enum name="ROW_REVERSE" value="1"/>
            <enum name="COLUMN" value="2"/>
            <enum name="COLUMN_REVERSE" value="3"/>
        </attr>

        <attr name="labelAlign" format="enum">
            <enum name="START" value="0"/>
            <enum name="END" value="1"/>
            <enum name="CENTER" value="2"/>
            <enum name="SPACE_BETWEEN" value="3"/>
            <enum name="SPACE_AROUND" value="4"/>
            <enum name="STRETCH" value="5"/>
        </attr>
    </declare-styleable>
</resources>